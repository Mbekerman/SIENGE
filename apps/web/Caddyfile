# Front do ERP no Cloud Run (o Cloud Run define $PORT, 8080). Base: Caddyfile do BKM Terrenos.
:{$PORT:8080} {
	encode zstd gzip

	# Cabeçalhos de segurança. A CSP principal vai na meta do index.html (vite.config.ts);
	# frame-ancestors só vale por cabeçalho: ninguém põe o ERP dentro de outra página.
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	root * /srv
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	@pagina not path /assets/*
	header @pagina Cache-Control "no-cache"
	# a página recebe SUPABASE_URL, SUPABASE_KEY e AMBIENTE nas metas (templates)
	templates {
		mime text/html
		between {% %}
	}
	# endereço que não é arquivo vai para o index.html (o react-router resolve), menos /assets
	@spa {
		not path /assets/*
		not file
	}
	rewrite @spa /index.html
	file_server
}
